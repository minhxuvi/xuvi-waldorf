# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Required in every environment:
DATABASE_URL=postgresql://user:password@host:5432/postgres
AUTH_SECRET=change-me-to-32-plus-random-chars

# Primary AI (Meta Model API, Standard tier only — never Contributor for product data):
META_API_KEY=

# Fallbacks (at least one LLM fallback recommended; others optional/stub):
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
IMAGE_FALLBACK_API_KEY=
STT_FALLBACK_API_KEY=

# Object storage (waived for local dev → local-stub mode):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# App:
APP_BASE_URL=http://localhost:3000
PORT=3000
