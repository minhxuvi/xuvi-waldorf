{
  "name": "xuvi-waldorf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Teacher-facing web product for Waldorf-inspired homeschooling in Vietnam (XuVi Story + six documents). Vietnamese-first.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:e2e": "node scripts/e2e-health.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
